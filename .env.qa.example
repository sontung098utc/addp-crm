# ==============================================================================
# ADDP AI CRM — QA AGENT CONFIGURATION TEMPLATE (.env.qa.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép tệp này thành .env.qa (hoặc truyền qua biến môi trường của hệ thống):
#    cp .env.qa.example .env.qa
# 2. KHÔNG commit tệp .env.qa chứa thông tin nhạy cảm vào Git (đã được .gitignore).
# 3. Mặc định công cụ chạy ở chế độ READ-ONLY (Chỉ đọc), an toàn tuyệt đối.
# ==============================================================================

# 1. Môi trường mục tiêu kiểm thử (Bắt buộc)
# Giá trị hợp lệ: local | staging | production
QA_TARGET=local

# 2. Địa chỉ máy chủ mục tiêu (Base URL)
# local:      http://localhost:3000
# staging:    https://staging-crm.addp.vn (hoặc domain staging nội bộ)
# production: https://crm.addp.vn
QA_BASE_URL=http://localhost:3000

# 3. Khóa an toàn bắt buộc khi target=production (Safety Gate)
# Để ngăn chặn vô tình chạy kiểm thử lên môi trường sản xuất, khi QA_TARGET=production,
# QA Agent sẽ TỪ CHỐI CHẠY nếu biến dưới đây không được đặt chính xác là "true".
QA_CONFIRM_PRODUCTION=false

# 4. Nhóm bài kiểm tra cần chạy (Test Group)
# Giá trị: health | auth | ui-readonly | integrations-readonly | security-safe | audit-claims | all-readonly
QA_GROUP=all-readonly

# 5. Tài khoản kiểm thử có quyền tối thiểu (Test Account - READ ONLY)
# CHỈ DÙNG TÀI KHOẢN KIỂM THỬ ĐƯỢC CẤP RIÊNG, KHÔNG DÙNG TÀI KHOẢN ADMIN THẬT
QA_TEST_STAFF_CODE=QA_TEST_01
QA_TEST_STAFF_ROLE=SALE
QA_TEST_SESSION_TOKEN=mock_test_session_token_xyz123

# 6. Cấu hình Timeout & Tải (Bảo vệ chống nghẽn mạng)
QA_REQUEST_TIMEOUT_MS=5000
QA_MAX_CONCURRENT_REQUESTS=3
QA_DELAY_BETWEEN_REQUESTS_MS=200

# 7. Thư mục xuất báo cáo kiểm thử
QA_REPORT_DIR=./reports/qa
