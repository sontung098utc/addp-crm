// ============================================================================
// ADDP OMNICHANNEL AI CRM & ERP — SCHEMA MYSQL 8.0 HỢP NHẤT (addp_crm)
// Bản đồng bộ trực tiếp từ database/schema.prisma cho Next.js Portal (WBS-03 & WBS-04)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  SALE_LEADER
  SALE
  CSKH
  KHO
  KE_TOAN
}

enum PlatformType {
  ZALO_PERSONAL
  ZALO_OA
  FACEBOOK
  TIKTOK_SHOP
  SHOPEE
  KIOTVIET
  MAGENTO
  CALL
  SMS
  OTHER
}

enum AiReplyMode {
  AUTO_REPLY
  DRAFT_ONLY
  HUMAN_ONLY
  OFF
}

enum CustomerVipLevel {
  NEW
  REPEAT_2
  LOYAL_3
  VIP_5
}

enum InteractionStatus {
  SUCCESS
  NO_ANSWER
  UNREACHABLE
  BUSY
}

enum FeedbackRating {
  GOOD
  BAD
  NONE
}

enum TaskType {
  DAY_1
  DAY_3
  DAY_7
  DAY_14
  DAY_21
  HALF_USAGE
  TWO_THIRD_USAGE
  OTHER
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum ConversationState {
  NEED_HUMAN
  AI_HANDLING
  HUMAN_HANDLING
  LOG_ONLY
}

model Staff {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(64)
  name            String    @db.VarChar(191)
  email           String?   @db.VarChar(191)
  phone           String?   @db.VarChar(32)
  password        String?   @db.VarChar(255)
  role            StaffRole @default(SALE)
  teamName        String?   @db.VarChar(100)
  tabPermissions  Json?
  kpi             BigInt    @default(0)
  dailyCareTarget Int       @default(7)
  dailyMsgTarget  Int       @default(70)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customers          Customer[]
  orders             Order[]
  tasks              Task[]
  interactions       Interaction[]
  channelPermissions StaffChannelPermission[]
  conversations      Conversation[]

  @@index([role, isActive])
  @@map("staff")
}

model ChannelAccount {
  id                 Int          @id @default(autoincrement())
  platform           PlatformType
  accountKey         String       @db.VarChar(128)
  accountName        String       @db.VarChar(255)
  shopId             String?      @db.VarChar(128)
  shopCipher         String?      @db.VarChar(255)
  appKey             String?      @db.VarChar(128)
  appSecretEncrypted String?      @db.Text
  accessToken        String?      @db.Text
  refreshToken       String?      @db.Text
  tokenExpiresAt     DateTime?
  refreshExpiresAt   DateTime?
  webhookVerifyToken String?      @db.VarChar(255)
  sessionDir         String?      @db.VarChar(255)
  defaultAiMode      AiReplyMode  @default(DRAFT_ONLY)
  aiAgentSlug        String?      @db.VarChar(128)
  dailyMsgLimit      Int          @default(70)
  sentTodayCount     Int          @default(0)
  status             String       @default("CONNECTED") @db.VarChar(32)
  lastErrorMessage   String?      @db.Text
  lastSyncAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  staffPermissions   StaffChannelPermission[]
  conversations      Conversation[]
  orders             Order[]
  broadcastCampaigns BroadcastCampaign[]

  @@unique([platform, accountKey], map: "uq_platform_account_key")
  @@index([platform, status])
  @@map("channel_accounts")
}

model StaffChannelPermission {
  id                   Int      @id @default(autoincrement())
  staffId              Int
  channelAccountId     Int
  canView              Boolean  @default(true)
  canReply             Boolean  @default(true)
  canManage            Boolean  @default(false)
  isAutoAssignEligible Boolean  @default(true)
  createdAt            DateTime @default(now())

  staff          Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([staffId, channelAccountId], map: "uq_staff_channel")
  @@index([channelAccountId])
  @@map("staff_channel_permissions")
}

model Customer {
  id              Int              @id @default(autoincrement())
  code            String           @unique @db.VarChar(64)
  fullName        String           @db.VarChar(255)
  phone           String           @unique @db.VarChar(32)
  secondaryPhones String?          @db.VarChar(255)
  email           String?          @db.VarChar(191)
  address         String?          @db.Text
  province        String?          @db.VarChar(100)
  district        String?          @db.VarChar(100)
  ward            String?          @db.VarChar(100)
  age             Int?
  gender          String?          @db.VarChar(16)
  pathology       String?          @db.Text
  initialGlucose  Float?
  currentGlucose  Float?
  status          String?          @default("Khách Mới") @db.VarChar(64)
  vipLevel        CustomerVipLevel @default(NEW)
  careStatus      String?          @default("Đang chăm sóc") @db.VarChar(64)
  source          PlatformType?    @default(OTHER)
  staffId         Int?
  totalOrders     Int              @default(0)
  totalSpent      Decimal          @default(0.00) @db.Decimal(15, 2)
  lastOrderDate   DateTime?
  facebookUrl     String?          @db.VarChar(255)
  zaloUid         String?          @db.VarChar(128)
  vpageUrl        String?          @db.VarChar(255)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  staff         Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  carePlans     CarePlan[]
  interactions  Interaction[]
  orders        Order[]
  tasks         Task[]
  customerTags  CustomerTag[]
  conversations Conversation[]

  @@index([staffId])
  @@index([source])
  @@index([vipLevel])
  @@index([lastOrderDate])
  @@map("customers")
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  color       String   @default("#2563eb") @db.VarChar(32)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  customerTags CustomerTag[]

  @@map("tags")
}

model CustomerTag {
  id           Int      @id @default(autoincrement())
  customerId   Int
  tagId        Int
  assignedByAi Boolean  @default(false)
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId], map: "uq_customer_tag")
  @@index([tagId])
  @@map("customer_tags")
}

model CarePlan {
  id             Int      @id @default(autoincrement())
  customerId     Int
  productName    String   @db.VarChar(255)
  startDate      DateTime
  usageDays      Int      @default(15)
  historyChanges String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("care_plans")
}

model Interaction {
  id                Int               @id @default(autoincrement())
  customerId        Int
  staffId           Int?
  interactionDate   DateTime          @default(now())
  channel           PlatformType      @default(CALL)
  interactionStatus InteractionStatus @default(SUCCESS)
  content           String            @db.Text
  weeklyFeedback    String?           @db.Text
  healthIndexRaw    String?           @db.VarChar(255)
  feedbackRating    FeedbackRating    @default(NONE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([customerId, interactionDate])
  @@index([staffId])
  @@map("interactions")
}

model Task {
  id          Int           @id @default(autoincrement())
  customerId  Int
  staffId     Int
  orderId     Int?
  deadline    DateTime
  taskType    TaskType      @default(DAY_3)
  title       String?       @db.VarChar(255)
  priority    TaskPriority  @default(MEDIUM)
  channel     PlatformType? @default(ZALO_PERSONAL)
  isCompleted Boolean       @default(false)
  completedAt DateTime?
  resultNote  String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, isCompleted, deadline])
  @@index([customerId])
  @@map("tasks")
}

model Product {
  id                Int      @id @default(autoincrement())
  code              String   @unique @db.VarChar(128)
  name              String   @db.VarChar(255)
  unit              String   @default("Hộp") @db.VarChar(32)
  retailPrice       Decimal  @default(0.00) @db.Decimal(15, 2)
  costPrice         Decimal  @default(0.00) @db.Decimal(15, 2)
  usageDaysPerUnit  Int      @default(15)
  comboFormula      String?  @db.Text
  stockQuantity     Decimal  @default(0.00) @db.Decimal(15, 2)
  prepackedQuantity Decimal  @default(0.00) @db.Decimal(15, 2)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("products")
}

model SkuMapping {
  id                  Int          @id @default(autoincrement())
  platform            PlatformType
  shopId              String?      @db.VarChar(128)
  platformProductId   String       @db.VarChar(128)
  platformProductName String?      @db.VarChar(255)
  platformSkuId       String       @db.VarChar(128)
  platformSkuName     String?      @db.VarChar(255)
  sellerSku           String?      @db.VarChar(128)
  localItemCode       String       @db.VarChar(128)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([platform, platformProductId, platformSkuId], map: "uq_platform_product_sku")
  @@index([localItemCode])
  @@map("sku_mappings")
}

model Order {
  id                  Int          @id @default(autoincrement())
  code                String       @unique @db.VarChar(128)
  platform            PlatformType @default(KIOTVIET)
  channelAccountId    Int?
  platformOrderId     String?      @db.VarChar(128)
  customerId          Int
  staffId             Int?
  orderDate           DateTime     @default(now())
  deliveredDate       DateTime?
  status              String       @default("Đang xử lý") @db.VarChar(64)
  platformStatus      String?      @db.VarChar(64)
  deliveryStatus      String?      @db.VarChar(64)
  shippingProvider    String?      @db.VarChar(100)
  trackingNumber      String?      @db.VarChar(100)
  productsJson        String       @db.Text
  grossAmount         Decimal      @default(0.00) @db.Decimal(15, 2)
  subTotal            Decimal      @default(0.00) @db.Decimal(15, 2)
  shippingFee         Decimal      @default(0.00) @db.Decimal(15, 2)
  sellerDiscount      Decimal      @default(0.00) @db.Decimal(15, 2)
  platformDiscount    Decimal      @default(0.00) @db.Decimal(15, 2)
  platformFee         Decimal      @default(0.00) @db.Decimal(15, 2)
  affiliateCommission Decimal      @default(0.00) @db.Decimal(15, 2)
  adsCostAllocated    Decimal      @default(0.00) @db.Decimal(15, 2)
  cogsAmount          Decimal      @default(0.00) @db.Decimal(15, 2)
  netProfit           Decimal      @default(0.00) @db.Decimal(15, 2)
  buyerPayment        Decimal      @default(0.00) @db.Decimal(15, 2)
  isInventoryDeducted Boolean      @default(false)
  careTasksGenerated  Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff          Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  channelAccount ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([platform, orderDate])
  @@index([customerId])
  @@index([staffId])
  @@index([status, deliveryStatus])
  @@map("orders")
}

model OrderItem {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  platformLineItemId String?  @db.VarChar(128)
  productCode        String   @db.VarChar(128)
  productName        String   @db.VarChar(255)
  skuId              String?  @db.VarChar(128)
  skuName            String?  @db.VarChar(255)
  quantity           Int      @default(1)
  salePrice          Decimal  @default(0.00) @db.Decimal(15, 2)
  costPrice          Decimal  @default(0.00) @db.Decimal(15, 2)
  resolvedComboJson  Json?
  createdAt          DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productCode])
  @@map("order_items")
}

model InventoryLog {
  id              Int      @id @default(autoincrement())
  logDate         DateTime @db.Date
  logType         String   @default("OUT") @db.VarChar(32)
  salesChannel    String   @default("Khác") @db.VarChar(100)
  shippingUnit    String   @default("Khác") @db.VarChar(100)
  batchNumber     Int      @default(1)
  itemCode        String   @db.VarChar(128)
  quantity        Decimal  @db.Decimal(15, 2)
  externalOrderId String?  @db.VarChar(128)
  note            String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([logDate, salesChannel])
  @@index([itemCode])
  @@index([externalOrderId])
  @@map("inventory_logs")
}

model StockTake {
  id          Int      @id @default(autoincrement())
  balanceDate DateTime @db.Date
  itemCode    String   @db.VarChar(128)
  quantity    Decimal  @db.Decimal(15, 2)
  note        String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  @@unique([balanceDate, itemCode], map: "uq_balance_date_item")
  @@map("stock_takes")
}

model Conversation {
  id                 Int               @id @default(autoincrement())
  channelAccountId   Int
  platform           PlatformType
  externalThreadId   String            @db.VarChar(191)
  threadName         String            @db.VarChar(255)
  avatarUrl          String?           @db.VarChar(512)
  isGroup            Boolean           @default(false)
  customerId         Int?
  assignedStaffId    Int?
  handlerState       ConversationState @default(NEED_HUMAN)
  aiMode             AiReplyMode       @default(DRAFT_ONLY)
  unreadCount        Int               @default(0)
  totalMessages      Int               @default(0)
  lastMessageAt      DateTime          @default(now())
  lastMessagePreview String?           @db.Text
  lastSenderType     String            @default("CUSTOMER") @db.VarChar(32)
  aiDraftText        String?           @db.Text
  tagsJson           Json?
  isPinned           Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedStaff  Staff?         @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@unique([channelAccountId, externalThreadId], map: "uq_channel_thread")
  @@index([handlerState, lastMessageAt])
  @@index([assignedStaffId, lastMessageAt])
  @@index([customerId])
  @@map("conversations")
}

model Message {
  id                Int      @id @default(autoincrement())
  conversationId    Int
  externalMessageId String?  @db.VarChar(191)
  senderType        String   @default("CUSTOMER") @db.VarChar(32)
  senderName        String?  @db.VarChar(191)
  staffId           Int?
  content           String   @db.Text
  attachmentsJson   Json?
  isRead            Boolean  @default(false)
  sentAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

model BroadcastCampaign {
  id                 Int          @id @default(autoincrement())
  name               String       @db.VarChar(255)
  platform           PlatformType @default(ZALO_PERSONAL)
  channelAccountId   Int?
  filterCriteriaJson Json?
  templateContent    String       @db.Text
  useAiRewrite       Boolean      @default(true)
  minDelaySec        Int          @default(45)
  maxDelaySec        Int          @default(120)
  status             String       @default("DRAFT") @db.VarChar(32)
  totalTargets       Int          @default(0)
  sentCount          Int          @default(0)
  failedCount        Int          @default(0)
  scheduledAt        DateTime?
  createdByStaffId   Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  channelAccount ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@map("broadcast_campaigns")
}
