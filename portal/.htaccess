# ============================================================================
# ADDP CRM - DIRECTADMIN OPENLITESPEED REVERSE PROXY CONFIGURATION
# Đặt file này trong thư mục /home/addp/domains/crm.addp.vn/public_html
# Sử dụng extprocessor BackendCrm (trỏ về 127.0.0.1:3005)
# ============================================================================

RewriteEngine On
RewriteRule ^\.well-known/acme-challenge - [L]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ http://BackendCrm/$1 [P,L]
